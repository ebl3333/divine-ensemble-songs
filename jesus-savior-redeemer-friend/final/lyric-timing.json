  "lines": [
    {
      "end": null,
      "id": "xv4n1do",
      "start": 8.6,
      "text": "The Spirit of Jehovah"
    },
    {
      "end": null,
      "id": "sdd01sj",
      "start": 12.7,
      "text": "Is resting upon Me"
    },
    {
      "end": null,
      "id": "gr0aknr",
      "start": 16.87,
      "text": "I'm anointed by my Father"
    },
    {
      "end": null,
      "id": "w91c5t2",
      "start": 21.22,
      "text": "To bring hope to the weary"
    },
    {
      "end": 29.67,
      "id": "7sp1i8g",
      "start": 25.71,
      "text": "To bring love to the lost"
    },
    {
      "end": null,
      "id": "16vmuxd",
      "start": 34.67,
      "text": "You have sent me with the promise"
    },
    {
      "end": null,
      "id": "cf3u1m1",
      "start": 38.97,
      "text": "For the broken to be healed"
    },
    {
      "end": null,
      "id": "fmjr2b9",
      "start": 43.77,
      "text": "Chains are breaking hearts are rising"
    },
    {
      "end": null,
      "id": "1ruaen0",
      "start": 48.46,
      "text": "As Your freedom is revealed"
    },
    {
      "end": null,
      "id": "7nhjer1",
      "start": 53.71,
      "text": "Jesus God's Anointed"
    },
    {
      "end": null,
      "id": "q5rheh4",
      "start": 57.08,
      "text": "Lifting burdens giving hope"
    },
    {
      "end": null,
      "id": "wddi5ej",
      "start": 61.64,
      "text": "Binding wounds You heal my pain"
    },
    {
      "end": null,
      "id": "9k4c9yh",
      "start": 65.98,
      "text": "Pouring gladness over me"
    },
    {
      "end": null,
      "id": "6han3tv",
      "start": 70.41,
      "text": "Beauty rises from the ashes"
    },
    {
      "end": null,
      "id": "s2q4zsi",
      "start": 74.79,
      "text": "In Your love You set me free"
    },
    {
      "end": null,
      "id": "j9spmy2",
      "start": 79.35,
      "text": "Jesus Savior My Redeemer"
    },
    {
      "end": 87.93,
      "id": "p2yntqh",
      "start": 83.73,
      "text": "Precious Guardian precious Friend"
    },
    {
      "end": null,
      "id": "9evcbl7",
      "start": 94.02,
      "text": "You declare this is the season"
    },
    {
      "end": null,
      "id": "1o43cyu",
      "start": 98.06,
      "text": "Of Your mercy of Your light"
    },
    {
      "end": null,
      "id": "irychxs",
      "start": 102.66,
      "text": "Every captive finds redemption"
    },
    {
      "end": null,
      "id": "h49gw3k",
      "start": 106.9,
      "text": "Every prisoner takes flight"
    },
    {
      "end": null,
      "id": "uwe3g8f",
      "start": 111.42,
      "text": "You give garlands for the ashes"
    },
    {
      "end": null,
      "id": "mvos6wa",
      "start": 115.68,
      "text": "Turning mourning into song"
    },
    {
      "end": null,
      "id": "mfdntpc",
      "start": 120.18,
      "text": "By Your Spirit we are rising"
    },
    {
      "end": null,
      "id": "owarper",
      "start": 124.57,
      "text": "In Your strength we soar along"
    },
